NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — the actual backend the /api/* rewrite (next.config.mjs) and middleware.ts proxy
# to. Keeping NEXT_PUBLIC_API_URL relative makes the auth cookies same-origin with the frontend,
# which Next.js middleware needs in order to read them for server-side route protection.
BACKEND_ORIGIN=http://localhost:4000
