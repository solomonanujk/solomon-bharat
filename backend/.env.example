# Database
DATABASE_URL=postgresql://solomon:solomon@localhost:5432/solomon_bharat

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# auto = PayPal when configured; manual = bank transfer, confirmed by an admin
PAYMENT_MODE=auto
# AI writing help for product descriptions (Claude). Leave empty to disable.
ANTHROPIC_API_KEY=
# WhatsApp notifications (Twilio). Leave empty to log messages instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Cloudinary (image storage)
CLOUDINARY_URL=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Solomon Bharat <no-reply@solomonbharat.com>

# Gemini (AI content polish for product listings)
GEMINI_API_KEY=
# Solomon AI uses Gemini when GEMINI_API_KEY is set (else Claude via ANTHROPIC_API_KEY).
GEMINI_MODEL=
# Solomon AI tries OpenRouter free models first when this is set (or a key is saved in admin).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000

# Seed — initial SUPER_ADMIN, created only by prisma/seed.ts
SEED_ADMIN_EMAIL=admin@solomonbharat.com
SEED_ADMIN_PASSWORD=change-me-now
