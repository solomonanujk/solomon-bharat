# Database
DATABASE_URL=postgresql://solomon:solomon@localhost:5432/solomon_bharat

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# auto = PayPal when configured; manual = bank transfer, confirmed by an admin
PAYMENT_MODE=auto
# AI writing help for product descriptions (Claude). Leave empty to disable.
ANTHROPIC_API_KEY=
# WhatsApp notifications (Twilio). Leave empty to log messages instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public base URL of this API, e.g. https://api.example.com (no trailing slash). Twilio signs
# inbound WhatsApp webhooks over the full URL; point Twilio at <base>/api/v1/whatsapp/webhook.
WHATSAPP_WEBHOOK_BASE_URL=
# WhatsApp provider: auto (Meta if its settings below are complete, else Twilio, else log only), twilio or meta.
WHATSAPP_PROVIDER=auto
# Meta WhatsApp Cloud API (no per-message platform fee). Webhook URL: <base>/api/v1/whatsapp/webhook
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Approved templates for the link code and the notices (review results, orders, payouts, welcome, replies)
# (Meta: template name; Twilio: Content SID HX...). Empty = plain text, which only arrives inside
# WhatsApp's 24-hour window.
WHATSAPP_TEMPLATE_AUTH=
WHATSAPP_TEMPLATE_PRODUCT_APPROVED=
WHATSAPP_TEMPLATE_PRODUCT_REJECTED=
WHATSAPP_TEMPLATE_PRICING_APPROVED=
WHATSAPP_TEMPLATE_PRICING_REJECTED=
WHATSAPP_TEMPLATE_ORDER_STATUS=
WHATSAPP_TEMPLATE_PAYOUT_PAID=
WHATSAPP_TEMPLATE_SELLER_APPROVED=
WHATSAPP_TEMPLATE_AGENT_APPROVED=
WHATSAPP_TEMPLATE_NEW_MESSAGE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# WhatsApp listing AI (uses GEMINI_API_KEY). Cost controls: switch off, per-seller daily call cap, model.
WHATSAPP_AI_ENABLED=true
WHATSAPP_AI_DAILY_CAP=20
WHATSAPP_AI_MODEL=gemini-2.5-flash-lite
# Tried when the main model is busy or over its quota (free-tier Gemini allows only 20 requests a day per model;
# turn on billing for real use). Empty = no fallback.
WHATSAPP_AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Cloudinary (image storage)
CLOUDINARY_URL=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Solomon Bharat <no-reply@solomonbharat.com>

# Gemini (AI content polish for product listings)
GEMINI_API_KEY=
# Solomon AI uses Gemini when GEMINI_API_KEY is set (else Claude via ANTHROPIC_API_KEY).
GEMINI_MODEL=
# Solomon AI tries OpenRouter free models first when this is set (or a key is saved in admin).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000

# Seed — initial SUPER_ADMIN, created only by prisma/seed.ts
SEED_ADMIN_EMAIL=admin@solomonbharat.com
SEED_ADMIN_PASSWORD=change-me-now
