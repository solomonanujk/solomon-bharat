generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SELLER
  BUYER
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

enum AgentApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMITTED
}

enum CollectionStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  CONFIRMED
  PROCURING
  COLLECTED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum MessageSender {
  BUYER
  ADMIN
}

enum NotificationType {
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  ORDER_STATUS_CHANGED
  PAYOUT_PAID
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  AGENT_APPLICATION_APPROVED
  AGENT_APPLICATION_REJECTED
  NEW_MESSAGE
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  role            Role
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  sellerProfile SellerProfile?
  buyerProfile  BuyerProfile?
  agentProfile  AgentProfile?

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────
// Sellers
// ─────────────────────────────────────────────────────────────

model SellerApplication {
  id              String                  @id @default(uuid())
  businessName    String
  contactName     String
  email           String
  phone           String
  businessAddress String
  message         String?
  status          SellerApplicationStatus @default(PENDING)
  rejectionReason String?
  internalNotes   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  sellerProfile SellerProfile?

  @@index([status])
  @@map("seller_applications")
}

model SellerProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId     String?            @unique
  application       SellerApplication? @relation(fields: [applicationId], references: [id])
  businessName      String
  contactName       String
  phone             String
  businessAddress   String
  bankDetails       String?
  notificationPrefs Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  products Product[]
  payouts  Payout[]

  @@index([deletedAt])
  @@map("seller_profiles")
}

// ─────────────────────────────────────────────────────────────
// Agents
// ─────────────────────────────────────────────────────────────

model AgentApplication {
  id              String                 @id @default(uuid())
  businessName    String
  contactName     String
  email           String
  phone           String
  businessAddress String
  country         String
  message         String?
  status          AgentApplicationStatus @default(PENDING)
  rejectionReason String?
  internalNotes   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  agentProfile AgentProfile?

  @@index([status])
  @@map("agent_applications")
}

model AgentProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId   String?           @unique
  application     AgentApplication? @relation(fields: [applicationId], references: [id])
  businessName    String
  contactName     String
  phone           String
  businessAddress String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  catalogues Catalogue[]

  @@index([deletedAt])
  @@map("agent_profiles")
}

// ─────────────────────────────────────────────────────────────
// Buyers
// ─────────────────────────────────────────────────────────────

model BuyerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  contactName String
  phone       String?
  country     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  addresses     Address[]
  wishlistItems WishlistItem[]
  messages      Message[]
  orders        Order[]
  reviews       Review[]

  @@index([deletedAt])
  @@map("buyer_profiles")
}

model Address {
  id         String       @id @default(uuid())
  buyerId    String
  buyer      BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders Order[]

  @@index([buyerId])
  @@map("addresses")
}

model WishlistItem {
  id        String       @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@map("wishlist_items")
}

model Message {
  id        String        @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sender    MessageSender
  body      String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([buyerId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// Categories (3-level hierarchy)
// ─────────────────────────────────────────────────────────────

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  level       Int
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryTree")
  description String?
  heroImage   String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products Product[]

  @@index([parentId])
  @@index([level])
  @@index([status])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// Products
// ─────────────────────────────────────────────────────────────

model Product {
  id              String                @id @default(uuid())
  sellerId        String
  seller          SellerProfile         @relation(fields: [sellerId], references: [id])
  categoryId      String
  category        Category              @relation(fields: [categoryId], references: [id])
  name            String
  slug            String                @unique
  description     String
  materials       String
  dimensions      String?
  weight          String?
  moq             Int
  declaredStock   Int
  sellerPrice     Decimal               @db.Decimal(12, 2)
  adminPrice      Decimal?              @db.Decimal(12, 2)
  agentPrice      Decimal?              @db.Decimal(12, 2)
  leadTime        String?
  approvalStatus  ProductApprovalStatus @default(PENDING)
  rejectionReason String?
  isPublished     Boolean               @default(false)
  isFeatured      Boolean               @default(false)
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  // Listing detail fields (parity with the solomon-bharat2 "Add Product" experience)
  tags          String[] @default([])
  stepQty       Int      @default(1)
  isHandmade    Boolean  @default(false)
  placeOfOrigin String?
  isGITagged    Boolean  @default(false)
  howItIsMade   String?
  artisanName   String?

  images       ProductImage[]
  variants     ProductVariant[]
  priceTiers   ProductPriceTier[]
  collections  ProductCollection[]
  wishlistedBy WishlistItem[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Volume / tiered pricing — one row per MOQ breakpoint. sellerPrice is set by the
// seller at submission; adminPrice is set separately by an admin per tier, once
// reviewed (mirrors how Product.adminPrice is set apart from Product.sellerPrice).
model ProductPriceTier {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  moq         Int
  sellerPrice Decimal  @db.Decimal(12, 2)
  adminPrice  Decimal? @db.Decimal(12, 2)
  agentPrice  Decimal? @db.Decimal(12, 2)

  @@index([productId])
  @@map("product_price_tiers")
}

model ProductVariant {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  value     String
  sku       String?       @unique
  status    VariantStatus @default(ACTIVE)
  imageUrl  String?
  createdAt DateTime      @default(now())

  // Full attribute set for multi-axis variant combos (Size + Color + Material + …).
  // `type`/`value` above always mirror the first axis for backward-compatible display.
  attributes VariantAttribute[]
  priceTiers VariantPriceTier[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantAttribute {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String
  value     String

  @@index([variantId])
  @@map("variant_attributes")
}

model VariantPriceTier {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  moq         Int
  sellerPrice Decimal        @db.Decimal(12, 2)
  adminPrice  Decimal?       @db.Decimal(12, 2)
  agentPrice  Decimal?       @db.Decimal(12, 2)

  @@index([variantId])
  @@map("variant_price_tiers")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

// ─────────────────────────────────────────────────────────────
// Collections
// ─────────────────────────────────────────────────────────────

model Collection {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  heroImage      String?
  editorialIntro String?
  isFeatured     Boolean          @default(false)
  status         CollectionStatus @default(DRAFT)
  publishAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  products ProductCollection[]

  @@index([status])
  @@map("collections")
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id                     String       @id @default(uuid())
  buyerId                String
  buyer                  BuyerProfile @relation(fields: [buyerId], references: [id])
  shippingAddressId      String?
  shippingAddress        Address?     @relation(fields: [shippingAddressId], references: [id])
  status                 OrderStatus  @default(PENDING_PAYMENT)
  adminPriceTotal        Decimal      @db.Decimal(12, 2)
  sellerPriceTotal       Decimal      @db.Decimal(12, 2)
  adminMargin            Decimal      @db.Decimal(12, 2)
  placedAsAgent          Boolean      @default(false)
  trackingNumber         String?
  exportDocuments        Json?
  expectedCollectionDate DateTime?
  cancelledReason        String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  items    OrderItem[]
  payments Payment[]
  payouts  Payout[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([placedAsAgent])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  sellerId        String
  quantity        Int
  unitAdminPrice  Decimal  @db.Decimal(12, 2)
  unitSellerPrice Decimal  @db.Decimal(12, 2)
  lineAdminTotal  Decimal  @db.Decimal(12, 2)
  lineSellerTotal Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payout Payout?
  review Review?

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orderItemId String       @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  images ReviewImage[]

  @@index([productId])
  @@index([buyerId])
  @@map("reviews")
}

model ReviewImage {
  id        String @id @default(uuid())
  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)

  @@index([reviewId])
  @@map("review_images")
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("PAYPAL")
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// Payouts
// ─────────────────────────────────────────────────────────────

model Payout {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  orderItemId String        @unique
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  status      PayoutStatus  @default(PENDING)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sellerId])
  @@index([orderId])
  @@index([status])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// Admin — audit log & settings
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────
// Agent catalogues
// ─────────────────────────────────────────────────────────────

model Catalogue {
  id         String       @id @default(uuid())
  agentId    String
  agent      AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title      String
  productIds String[]
  fileUrl    String
  publicId   String?
  createdAt  DateTime     @default(now())

  @@index([agentId])
  @@map("catalogues")
}
