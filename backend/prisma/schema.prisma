generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SELLER
  BUYER
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

enum AgentApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO_REQUESTED
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductSource {
  WEB
  WHATSAPP
}

enum WhatsAppSessionState {
  COLLECTING
  AWAITING_ANSWERS
  AWAITING_CONFIRM
}

enum ProductApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  RESUBMITTED
}

enum ProductPricingChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CollectionStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  CONFIRMED
  PROCURING
  COLLECTED
  /// Curated only: checked at the Jaipur warehouse, with dispatch photos attached.
  QUALITY_CHECKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  /// A paid order that was cancelled and has had its money returned.
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum MessageSender {
  BUYER
  ADMIN
}

enum NotificationType {
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  ORDER_STATUS_CHANGED
  PAYOUT_PAID
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  AGENT_APPLICATION_APPROVED
  AGENT_APPLICATION_REJECTED
  NEW_MESSAGE
  PRODUCT_PRICING_CHANGE_APPROVED
  PRODUCT_PRICING_CHANGE_REJECTED
  NEW_ORDER_RECEIVED
  BRAND_APPLICATION_APPROVED
}

/// How a seller sells. Only CURATED is used since Oct 2026 (marketplace removed; kept for history,
/// see docs/MARKETPLACE_MODEL_ARCHIVE.md). CURATED = Solomon Bharat is the merchant (admin reviews and
/// prices every product). MARKETPLACE = the seller is a brand that sets its own
/// prices, publishes its own products and ships its own orders; Solomon collects
/// payment and keeps a commission.
enum RfqStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CLOSED
}

enum SellerType {
  CURATED
  MARKETPLACE
}

enum BrandStatus {
  ACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  /// Set when an admin approval emails a temporary password; cleared once the user picks their own.
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  rfqs                    Rfq[]

  sellerProfile SellerProfile?
  buyerProfile  BuyerProfile?
  agentProfile  AgentProfile?

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────
// Sellers
// ─────────────────────────────────────────────────────────────

model SellerApplication {
  id              String                  @id @default(uuid())
  businessName    String
  contactName     String
  email           String
  phone           String
  businessAddress String
  message         String?
  status          SellerApplicationStatus @default(PENDING)
  rejectionReason String?
  internalNotes   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // "Apply to list your brand" wizard fields (Brand/Products/Export readiness/
  // Final details) — all nullable/defaulted at the DB level even where the form
  // treats them as required, so this migration never fails against existing rows;
  // required-ness is enforced by Zod at the API boundary for new submissions only.
  city                    String?
  country                 String?  @default("India")
  instagramHandle         String?
  instagramFollowers      Int?
  websiteOrSocialLink     String?
  craftCategories         String[] @default([])
  productDescription      String?
  giTaggedProducts        String?
  monthlySalesVolume      String?
  shippedInternationally  Boolean?
  approxExportOrders      String?
  exportCountries         String?
  sellingOnAmazon         String?
  otherPlatforms          String[] @default([])
  gstRegistration         String?
  companyIncorporation    String?
  iecStatus               String?
  businessType            String?
  hearAboutUs             String?
  agreedToCommissionTerms Boolean  @default(false)

  // Seller-type question (first onboarding step) and the marketplace-brand answers.
  // Brand fields are only used when sellerType = MARKETPLACE; the commission terms
  // version/timestamp record exactly which terms the applicant accepted.
  sellerType             SellerType @default(CURATED)
  brandName              String?
  brandLogoUrl           String?
  brandBannerUrl         String?
  brandStory             String?
  brandWebsite           String?
  minOrderValueInr       Decimal?   @db.Decimal(12, 2)
  commissionTermsVersion String?
  commissionAgreedAt     DateTime?

  /// Admin shortlist: starred applications the owner wants to come back to.
  isFavourite    Boolean   @default(false)
  favouritedById String?
  favouritedAt   DateTime?

  sellerProfile SellerProfile?

  @@index([status])
  @@index([isFavourite])
  @@map("seller_applications")
}

model SellerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId      String?            @unique
  application        SellerApplication? @relation(fields: [applicationId], references: [id])
  businessName       String
  contactName        String
  phone              String
  businessAddress    String
  bankDetails        String?
  notificationPrefs  Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  sellerType         SellerType         @default(CURATED)
  /// Seller-controlled: while true their products cannot be ordered.
  isOnVacation       Boolean            @default(false)
  /// Admin-only performance rating (1-5) and notes. Never sent to the seller.
  internalRating     Int?
  internalNotes      String?
  /// Verified WhatsApp number (E.164) the seller lists products from; unique across sellers.
  whatsappNumber     String?            @unique
  whatsappVerifiedAt DateTime?

  products          Product[]
  payouts           Payout[]
  whatsappLinkCodes WhatsAppLinkCode[]
  whatsappSessions  WhatsAppSession[]
  whatsappAiUsage   WhatsAppAiUsage[]
  brand             Brand?
  /// Orders fulfilled by this seller (marketplace brands only).
  orders            Order[]            @relation("BrandOrders")

  @@index([deletedAt])
  @@index([sellerType])
  @@map("seller_profiles")
}

/// A short-lived code sent to a seller's WhatsApp to prove they own the number. Only a hash is kept.
model WhatsAppLinkCode {
  id        String        @id @default(uuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  attempts  Int           @default(0)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([sellerId, createdAt])
  @@map("whatsapp_link_codes")
}

/// A listing a seller is building in chat. One per number; deleted on submit, cancel or expiry.
/// Photos are uploaded to storage as they arrive, so only their URLs are kept here.
model WhatsAppSession {
  id            String               @id @default(uuid())
  sellerId      String
  seller        SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  phone         String               @unique
  state         WhatsAppSessionState @default(COLLECTING)
  /// 'en' | 'hi' | 'hinglish' — the language replies are written in.
  language      String               @default("en")
  /// Text messages received since the last AI/answer pass.
  texts         String[]
  imageUrls     String[]
  videoUrls     String[]
  /// Listing fields collected so far (see whatsapp.listing.ts).
  collected     Json                 @default("{}")
  /// Field keys the last question message asked for.
  missing       String[]
  aiCalls       Int                  @default(0)
  lastMessageAt DateTime             @default(now())
  expiresAt     DateTime
  createdAt     DateTime             @default(now())

  @@index([expiresAt])
  @@map("whatsapp_sessions")
}

/// AI calls made for a seller on one day, so a daily cap can keep the bill predictable.
model WhatsAppAiUsage {
  id           String        @id @default(uuid())
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// UTC date, YYYY-MM-DD.
  day          String
  calls        Int           @default(0)
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)

  @@unique([sellerId, day])
  @@map("whatsapp_ai_usage")
}

/// Every WhatsApp message the webhook has accepted. The unique provider message id makes
/// Twilio retries harmless: a repeat is dropped before it can trigger an AI call or a reply.
model WhatsAppMessage {
  id                String   @id @default(uuid())
  providerMessageId String   @unique
  /// Sender's normalised number (+919812345678).
  phone             String
  type              String
  mediaCount        Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([phone, createdAt])
  @@map("whatsapp_messages")
}

// ─────────────────────────────────────────────────────────────
// Agents
// ─────────────────────────────────────────────────────────────

model AgentApplication {
  id              String                 @id @default(uuid())
  businessName    String
  contactName     String
  email           String
  phone           String
  businessAddress String
  country         String
  message         String?
  status          AgentApplicationStatus @default(PENDING)
  rejectionReason String?
  internalNotes   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  agentProfile AgentProfile?

  @@index([status])
  @@map("agent_applications")
}

model AgentProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId   String?           @unique
  application     AgentApplication? @relation(fields: [applicationId], references: [id])
  businessName    String
  contactName     String
  phone           String
  businessAddress String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  catalogues Catalogue[]

  @@index([deletedAt])
  @@map("agent_profiles")
}

// ─────────────────────────────────────────────────────────────
// Buyers
// ─────────────────────────────────────────────────────────────

model BuyerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  contactName String
  phone       String?
  country     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Faire-style onboarding wizard fields (signup only — all optional, collected
  // progressively across the multi-step "Unlock wholesale pricing" modal).
  businessType       String?
  businessOpenedYear String?
  website            String?
  hearAboutUs        String[] @default([])
  marketingOptOut    Boolean  @default(false)
  preferredLanguage  String?

  addresses     Address[]
  wishlistItems WishlistItem[]
  brandFollows  BrandFollow[]
  ownBrands     BrandOwnBuyer[]
  messages      Message[]
  orders        Order[]
  reviews       Review[]

  @@index([deletedAt])
  @@map("buyer_profiles")
}

model Address {
  id         String       @id @default(uuid())
  buyerId    String
  buyer      BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orders Order[]

  @@index([buyerId])
  @@map("addresses")
}

model WishlistItem {
  id        String       @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@map("wishlist_items")
}

model Message {
  id        String        @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sender    MessageSender
  body      String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([buyerId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// Categories (3-level hierarchy)
// ─────────────────────────────────────────────────────────────

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  level       Int
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryTree")
  description String?
  heroImage   String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products Product[]

  @@index([parentId])
  @@index([level])
  @@index([status])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// Products
// ─────────────────────────────────────────────────────────────

model Product {
  id              String                @id @default(uuid())
  sellerId        String
  seller          SellerProfile         @relation(fields: [sellerId], references: [id])
  /// Set for marketplace-brand products only; null = Solomon-curated.
  brandId         String?
  brand           Brand?                @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category              @relation(fields: [categoryId], references: [id])
  name            String
  slug            String                @unique
  description     String
  materials       String
  dimensions      String?
  weight          String?
  moq             Int
  declaredStock   Int
  sellerPrice     Decimal               @db.Decimal(12, 2)
  adminPrice      Decimal?              @db.Decimal(12, 2)
  agentPrice      Decimal?              @db.Decimal(12, 2)
  leadTime        String?
  approvalStatus  ProductApprovalStatus @default(PENDING)
  rejectionReason String?
  isPublished     Boolean               @default(false)
  isFeatured      Boolean               @default(false)
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  // Listing detail fields (parity with the solomon-bharat2 "Add Product" experience)
  tags             String[] @default([])
  stepQty          Int      @default(1)
  isHandmade       Boolean  @default(false)
  placeOfOrigin    String?
  isGITagged       Boolean  @default(false)
  howItIsMade      String?
  craftTechnique   String?
  careInstructions String?
  /// true = made to order (lead time applies); false = ready stock.
  isMadeToOrder    Boolean  @default(false)
  /// Samples: whether the product can be ordered as a sample, the most units per sample
  /// order, and the price per sample unit in INR (brand-set for marketplace, admin-set for curated).
  offersSamples    Boolean  @default(false)
  sampleMaxQty     Int?
  samplePrice      Decimal? @db.Decimal(12, 2)
  artisanName      String?
  craftImageUrl    String?

  // Faire-parity fields (see PRD §8.5/§8.9, §15.3)
  ecoMaterials  String[]      @default([])
  ecoPackaging  String[]      @default([])
  ecoProduction String[]      @default([])
  isBestseller  Boolean       @default(false)
  tariffCode    String?       @db.VarChar(50)
  /// Where the listing was created: the website form or a seller's WhatsApp chat.
  source        ProductSource @default(WEB)

  images                ProductImage[]
  videos                ProductVideo[]
  variants              ProductVariant[]
  priceTiers            ProductPriceTier[]
  collections           ProductCollection[]
  wishlistedBy          WishlistItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  pricingChangeRequests ProductPricingChangeRequest[]
  rfqs                  Rfq[]

  @@index([sellerId])
  @@index([brandId])
  @@index([categoryId])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_videos")
}

// Volume / tiered pricing — one row per MOQ breakpoint. sellerPrice is set by the
// seller at submission; adminPrice is set separately by an admin per tier, once
// reviewed (mirrors how Product.adminPrice is set apart from Product.sellerPrice).
model ProductPriceTier {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  moq         Int
  sellerPrice Decimal  @db.Decimal(12, 2)
  adminPrice  Decimal? @db.Decimal(12, 2)
  agentPrice  Decimal? @db.Decimal(12, 2)

  @@index([productId])
  @@map("product_price_tiers")
}

model ProductVariant {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  value     String
  sku       String?       @unique
  status    VariantStatus @default(ACTIVE)
  imageUrl  String?
  createdAt DateTime      @default(now())

  // Faire-parity per-variant shipping/inventory detail (see PRD §8.5/§8.9, §15.3).
  // Product.weight/dimensions/declaredStock stay authoritative for the no-variant
  // case; when variants exist, these per-variant fields take over and
  // Product.declaredStock is derived as their sum (see products.service.ts).
  weight        Decimal? @db.Decimal(10, 2)
  weightUnit    String?  @default("kg")
  length        Decimal? @db.Decimal(10, 2)
  width         Decimal? @db.Decimal(10, 2)
  height        Decimal? @db.Decimal(10, 2)
  dimensionUnit String?  @default("cm")
  tariffCode    String?  @db.VarChar(50)
  inventory     Int?

  // Full attribute set for multi-axis variant combos (Size + Color + Material + …).
  // `type`/`value` above always mirror the first axis for backward-compatible display.
  attributes VariantAttribute[]
  priceTiers VariantPriceTier[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantAttribute {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name      String
  value     String

  @@index([variantId])
  @@map("variant_attributes")
}

model VariantPriceTier {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  moq         Int
  sellerPrice Decimal        @db.Decimal(12, 2)
  adminPrice  Decimal?       @db.Decimal(12, 2)
  agentPrice  Decimal?       @db.Decimal(12, 2)

  @@index([variantId])
  @@map("variant_price_tiers")
}

// A seller's proposed pricing/variant change to an already-APPROVED (live) product.
// Buyers keep seeing Product/ProductPriceTier/ProductVariant exactly as they are —
// nothing here touches those rows — until an admin approves it, at which point it
// replaces them atomically (see ProductsRepository.applyPricingChange). Rejecting
// leaves the live product completely untouched.
model ProductPricingChangeRequest {
  id                  String                     @id @default(uuid())
  productId           String
  product             Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  status              ProductPricingChangeStatus @default(PENDING)
  proposedMoq         Int
  proposedSellerPrice Decimal                    @db.Decimal(12, 2)
  proposedPriceTiers  Json
  proposedVariants    Json
  rejectionReason     String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([productId, status])
  @@map("product_pricing_change_requests")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

// ─────────────────────────────────────────────────────────────
// Collections
// ─────────────────────────────────────────────────────────────

model Collection {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  heroImage      String?
  editorialIntro String?
  isFeatured     Boolean          @default(false)
  status         CollectionStatus @default(DRAFT)
  publishAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  products ProductCollection[]

  @@index([status])
  @@map("collections")
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id                     String         @id @default(uuid())
  buyerId                String
  buyer                  BuyerProfile   @relation(fields: [buyerId], references: [id])
  /// Set on a marketplace brand's order; null = Solomon-curated order (admin pipeline).
  sellerProfileId        String?
  sellerProfile          SellerProfile? @relation("BrandOrders", fields: [sellerProfileId], references: [id])
  /// Groups the sibling orders created by one checkout (one PayPal payment).
  checkoutId             String?
  shippingAddressId      String?
  shippingAddress        Address?       @relation(fields: [shippingAddressId], references: [id])
  status                 OrderStatus    @default(PENDING_PAYMENT)
  adminPriceTotal        Decimal        @db.Decimal(12, 2)
  sellerPriceTotal       Decimal        @db.Decimal(12, 2)
  adminMargin            Decimal        @db.Decimal(12, 2)
  placedAsAgent          Boolean        @default(false)
  /// Marketplace only: the buyer is the brand's own (joined via its invite link). Locked at payment.
  brandOwnBuyer          Boolean        @default(false)
  trackingNumber         String?
  exportDocuments        Json?
  expectedCollectionDate DateTime?
  cancelledReason        String?
  /// When payment was confirmed. Marketplace brands must accept within 24h of this.
  paidAt                 DateTime?
  /// Photo URLs proving the goods' condition at dispatch. Required before shipping.
  dispatchPhotos         Json?
  refundedAt             DateTime?
  refundReference        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?

  items    OrderItem[]
  payments Payment[]
  payouts  Payout[]

  @@index([buyerId])
  @@index([sellerProfileId])
  @@index([checkoutId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([placedAsAgent])
  @@index([status, paidAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  sellerId         String
  quantity         Int
  unitAdminPrice   Decimal         @db.Decimal(12, 2)
  unitSellerPrice  Decimal         @db.Decimal(12, 2)
  lineAdminTotal   Decimal         @db.Decimal(12, 2)
  lineSellerTotal  Decimal         @db.Decimal(12, 2)
  /// Marketplace items only: locked at the paid transition. unitSellerPrice and
  /// lineSellerTotal above are then the NET after this commission.
  commissionRate   Decimal?        @db.Decimal(5, 2)
  commissionAmount Decimal?        @db.Decimal(12, 2)
  /// A sample purchase: priced at the product's sample price, exempt from MOQ and the
  /// brand's minimum order value, limited to the product's sample quantity.
  isSample         Boolean         @default(false)
  createdAt        DateTime        @default(now())

  payout Payout?
  review Review?

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orderItemId String       @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  images ReviewImage[]

  @@index([productId])
  @@index([buyerId])
  @@map("reviews")
}

model ReviewImage {
  id        String @id @default(uuid())
  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)

  @@index([reviewId])
  @@map("review_images")
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("PAYPAL")
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  /// Same value on every Payment row written by one checkout.
  checkoutId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([checkoutId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// Payouts
// ─────────────────────────────────────────────────────────────

model Payout {
  id               String        @id @default(uuid())
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id])
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  orderItemId      String        @unique
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  /// Marketplace payouts: amount = grossAmount - commissionAmount.
  grossAmount      Decimal?      @db.Decimal(12, 2)
  commissionRate   Decimal?      @db.Decimal(5, 2)
  commissionAmount Decimal?      @db.Decimal(12, 2)
  status           PayoutStatus  @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([sellerId])
  @@index([orderId])
  @@index([status])
  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// Admin — audit log & settings
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Marketplace brands
// ─────────────────────────────────────────────────────────────

/// Public-facing identity of a MARKETPLACE seller. Kept separate from the private
/// SellerProfile so the buyer-facing serializer can whitelist fields. legalName and
/// gstin are PRIVATE (invoices/admin only) — never expose them publicly.
model Brand {
  id                       String        @id @default(uuid())
  sellerProfileId          String        @unique
  sellerProfile            SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String        @unique
  logoUrl                  String?
  bannerUrl                String?
  story                    String?
  country                  String?
  website                  String?
  instagram                String?
  returnPolicy             String?
  /// Minimum order value for this brand's items in one checkout, in INR.
  minOrderValueInr         Decimal       @default(0) @db.Decimal(12, 2)
  isVerified               Boolean       @default(false)
  status                   BrandStatus   @default(ACTIVE)
  /// Per-brand overrides of the platform default commission (percent, e.g. 25.00).
  commissionFirstOverride  Decimal?      @db.Decimal(5, 2)
  commissionRepeatOverride Decimal?      @db.Decimal(5, 2)
  /// Shareable code for the brand's personal invite link (/invite/<code>). Buyers who join
  /// through it are the brand's own buyers: 0% commission and payout on payment.
  inviteCode               String?       @unique
  legalName                String?
  gstin                    String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  products     Product[]
  followers    BrandFollow[]
  ownBuyers    BrandOwnBuyer[]
  emailInvites BrandEmailInvite[]

  @@index([status])
  @@map("brands")
}

/// A buyer the brand brought to the platform through its invite link.
model BrandOwnBuyer {
  id        String       @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([buyerId, brandId])
  @@index([brandId])
  @@map("brand_own_buyers")
}

/// An emailed invite from a brand to someone without a buyer account yet. Claimed (and the
/// buyer recorded as the brand's own) when they sign up with this email.
model BrandEmailInvite {
  id        String    @id @default(uuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  email     String
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([brandId, email])
  @@index([email])
  @@map("brand_email_invites")
}

model BrandFollow {
  id        String       @id @default(uuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([buyerId, brandId])
  @@index([brandId])
  @@map("brand_follows")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────
// Agent catalogues
// ─────────────────────────────────────────────────────────────

model Catalogue {
  id        String       @id @default(uuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  // Array of {productId, price, moq} — the agent's own resale price/MOQ per
  // product, set at generation time and frozen into the PDF from then on.
  items     Json
  fileUrl   String
  publicId  String?
  createdAt DateTime     @default(now())

  @@index([agentId])
  @@map("catalogues")
}

// ─────────────────────────────────────────────────────────────
// Custom requirements (RFQ) — always handled by the Solomon team
// ─────────────────────────────────────────────────────────────

model Rfq {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The listing the request started from, if any.
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  description        String
  quantity           Int
  /// In the buyer's currency (see `currency`).
  targetPrice        Decimal?  @db.Decimal(12, 2)
  currency           String?
  destinationCountry String
  deadline           DateTime?
  referenceImages    Json?
  status             RfqStatus @default(NEW)
  /// A sample order placed from a product page (quantity within the product's sample limit).
  isSample           Boolean   @default(false)
  adminNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@map("rfqs")
}

// ─── Solomon AI (public business guide) ─────────────────────────────────────

enum GuideKnowledgeStatus {
  PROCESSING
  READY
  FAILED
}

enum GuideKnowledgeKind {
  TEXT
  PDF
  IMAGE
  SPREADSHEET
}

/// Material the admin feeds the Solomon AI guide. `content` is the text the AI reads
/// (typed text, or text read out of a PDF / image / spreadsheet at upload).
model GuideKnowledge {
  id          String               @id @default(uuid())
  title       String
  kind        GuideKnowledgeKind
  content     String
  /// Uploaded files are read in the background: PROCESSING -> READY or FAILED.
  status      GuideKnowledgeStatus @default(READY)
  error       String?
  /// Short AI summary of what was learned (key points), shown to the admin.
  summary     String?
  fileUrl     String?
  fileName    String?
  sizeBytes   Int?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([createdAt])
  @@map("guide_knowledge")
}

/// One visitor's chat with the guide. Name, email and phone are required before chatting.
model GuideConversation {
  id           String   @id @default(uuid())
  /// Secret the visitor's browser holds to continue this chat.
  token        String   @unique
  name         String
  email        String
  phone        String
  country      String?
  /// [{ role: 'user' | 'assistant', content: string, at: ISO date }]
  messages     Json     @default("[]")
  messageCount Int      @default(0)
  /// Products the visitor liked or saved: [{ key, name, image, link, liked, saved }]
  saved        Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
  @@map("guide_conversations")
}
